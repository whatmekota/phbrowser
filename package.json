{
  "name": "phbrowser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:public": "node build.mjs --public --minify",
    "test": "node --import tsx --test test/address.test.ts test/bookmarks.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "description": "phbrowser: a web browser on playhound's stage, so a site plays while tap tempo or generated motion drives the device.",
  "license": "MIT"
}
